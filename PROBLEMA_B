.include "m328pdef.inc"

.cseg
.org 0x0000
rjmp RESET

RESET:
ldi r16, HIGH (RAMEND)
out SPH, r16
ldi r16, LOW (RAMEND)
out SPL, r16

; DAC: PD2-PD7 salidas
ldi r16, 0b11111100
out DDRD, r16

; DAC: PB0-PB1 salidas
ldi r16, 0b00000011
out DDRB, r16

;Salidas inicialmente en cero
ldi r16, 0
out PORTD, r16
out PORTB, r16

;USUART 9600 baud
ldi r16, 0
sts UBRR0H, r16
ldi r16, 103
sts UBRR0L, r16
ldi r16, (1<<RXEN0) | (1<<TXEN0)
sts UCSR0B, r16
ldi r16, (1<<UCSZ01) | (1<<UCSZ00)
sts UCSR0C, R16

MAIN:
rjmp MAIN
