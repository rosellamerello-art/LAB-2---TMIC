; ============================================================
; LABORATORIO 2 - PROBLEMA E
; AUTOMATIZACION DE PUERTA DE GARAJE
; ATmega328P / Arduino UNO
; Motor 28BYJ-48 + ULN2003
;
; ENTRADAS ACTIVAS EN LOW:
; D8 / PB0 = ABRIR
; D9 / PB1 = CERRAR
; D10 / PB2 = PUERTA ABIERTA
; D11 / PB3 = PUERTA CERRADA
; A0 / PC0 = OBSTACULO (PCINT8)
;
; MOTOR / ULN2003:
; D4 / PD4 = IN1
; D5 / PD5 = IN2
; D6 / PD6 = IN3
; D7 / PD7 = IN4
;
; INDICADORES:
; D12 / PB4 = LED ABRIENDO
; D13 / PB5 = LED CERRANDO
; A1 / PC1 = ALARMA / BUZZER
;
; USART:
; D0 / PD0 = RX
; D1 / PD1 = TX
;
; ESTADOS r20:
; 0=CERRADA, 1=ABRIENDO, 2=ABIERTA,
; 3=CERRANDO, 4=DETENIDA POR SEGURIDAD
;
; r21 = bandera de mensaje de obstaculo
; r22 = indice de paso del motor (0..7)
; ============================================================
.include "m328p. inc"
.cseg
.org PIC1addr 
rjmp PCINT_ISR

RESET:

ldi r16, HIGH(RAMEND)
out SPH, r16
ldi r16, LOW(RAMEND)
out SPL, r16

ldi r16, 0b00110000
out DDRB, r16
ldi r16, 0b00001111
out PORTB, r16

cbi DDRC, PC0
sbi PORTC, PC0
sbi DDRC, PC1
cbi PORTC, PC1

ldi r16, 0b11110000
out DDRD, r16
rcall MOTOR_OFF

ldi r16, 0
sts UBRR0H, r16
ldi r16, 103
sts UBRR0L, r16
ldi r16, (1<<RXEN0) | (1<<TXEN0)
sts UCSR0B, r16
ldi r16, (1<<UCSZ01)|(1<<UCSZ00)
sts UCSR0B, r16

ldi r16, (1<<PCIE1)
sts PCICR, r16
ldi r16, (1<<PCINT8)
sts PCMSK1, r16

ldi r20, 0
ldi r21, 0
ldi r22, 0

sei
rcall MSG_CERRADA

MAIN:

rcall REVISAR_MENSAJE_DE_SEGURIDAD
cpi r20, 0
breq ESTADO_CERRADA
cpi r20, 1
breq ESTADO_ABRIENDO
cpi r20, 2
breq ESTADO_ABIERTO
cpi r20, 3
breq ESTADO_CERRANDO
cpi r20, 4
breq ESTADO_DETENIDA
rjmp MAIN

; ESTADO 0
;------------------------------------

ESTADO_CERRADA:

rcall MOTOR_OFF
cbi PORTB, PB4
cbi PORTB, PB5
cbi PORTC, PC1

sbic PINB, PB0
rjmp MAIN

ESPERA_ABRIR:

sbis PINB, PB0
rjmp ESPERA_ABRIR

ldi r20, 1
rcall MSG_ABRIENDO
rjmp MAIN

; ESTADO 1
;-----------------------------------

ESTADO_ABRIENDO:

sbi PORTB, PB4
cbi PORTB, PB5
sbi PORTC, PC1

sbis PINB, PB2
rjmp LLEGO_ABIERTA

rcall PASO_ADELANTE
rcall RETARDO_MOTOR

rjmp MAIN

LLEGO_ABIERTA:
rcall MOTOR_OFF
cbi PORTB, PB4
cbi PORTC, PC1
ldi r20, 2
rcall MSG_ABIERTA

ESPERA_PUERTA_ABIERTA:

sbis PINB, PB2
rjmp ESPERA_PUERTA_ABIERTA
rjmp MAIN

;ESTADO 2
;---------------------------------

ESTADO_ABIERTA:

rcall MOTOR_OFF
cbi PORTB, PB4
cbi PORTB, PB5
cbi PORTC, PC1

sbic PINB, PB1
rjmp MAIN

ESPERA_CERRAR:
sbis PINB, PB1
rjmp ESPERA_CERRAR

ldi r20, 3
rcall MSG_CERRANDO
rjmp MAIN

;ESTADO 3
;-----------------------------

ESTADO_CERRANDO:

cbi PORTB, PB4
sbi PORTB, PB5
sbi PORTC, PC1

sbis PINB, PB3
rjmp LLEGO_CERRADA

rcall PASO_ATRAS
rcall RETARDO_MOTOR
rjmp MAIN

LLEGO_CERRADA:

rcall MOTOR_OFF
cbi PORTB, PB5
cbi PORTC, PC1
ldi r20, 0
rcall MSG_CERRADA

ESPERA_PUERTA_CERRADA:

sbis PINB, PB3
rjmp ESPERA_PUERTA_CERRADA
rjmp MAIN

;ESTADO 4
;-----------------------------

ESTADO_DETENIDA:

rcall MOTOR_OFF
cbi PORTB, PB4
cbi PORTB, PB5
cbi PORTC, PC1

sbic PINB, PB0
rjmp REVISAR_CERRAR_SEG

ESPERA_ABRIR_SEG:

sbis PINB, PB0
rjmp ESPERA_ABRIR_SEG
ldi r20, 1
rcall MSG_ABRIENDO
rjmp MAIN

REVISAR_CARRAR_SEG:
sbic PINB, PB1
rjmp MAIN

ESPERA_CERRAR_SEG:
sbic PINB, PB1
rjmp ESPERA_CERRAR_SEG
ldi r20, 3
rcall MSG_CERRANDO
rjmp MAIN

;INTERRUPCIÓN POR OBSTÁCULO
;-----------------------------------
PCINT1_ISR:
push r16
in r16, SREG
push r16

sbic PINC, PC0
rjmp FIN_PCINT1

cpi r20, 1
breq OBSTACULO_DETECTADO

cpi r20, 3
breq OBSTACULO_DETECTADO
rjmp FIN_PCINT1

OBSTACULO_DETECTADO:
in r16, PORTD
andi r16, 0b00001111
out PORTD, r16

cbi PORTB, PB4
cbi PORTB, PB5
cbi PORTC, PC1

ldi r20, 4
ldi r21, 1

FIN_PCINT1:
pop r16
out SREG, r16
pop r16
reti

REVISAR_MENSAJE_SEGURIDAD:
cpi r21, 1
brne FIN_REVISAR_SEG
ldi r21, 0
rcall MSG_OBSTACULO
rcall MSG_SEGURIDAD

FIN_REVISAR_SEG:
ret

;MOTOR PASO A PASO
;----------------------------------------

PASO_ADELANTE:
inc r22
andi r22, 0x07
rjmp ESCRIBIR_PASO

PASO_ATRAS:
tst r22
brne PA_DEC
ldi r22, 7
rjmp ESCRIBIR_PASO

PA_DEC:
dec r22

ESCRIBIR_PASO:
cpi r22, 0
breq STEP0
cpi r22, 1
breq STEP1
cpi r22, 2
breq STEP2
cpi r22, 3
breq STEP3
cpi r22, 4
breq STEP4
cpi r22, 5
breq STEP5
cpi r22, 6
breq STEP6
rjmp STEP7

STEP0:
ldi r16, 0x10
rjmp ESCRIBIR_MOTOR

STEP1:
ldi r16, 0x30
rjmp ESCRIBIR_MOTOR

STEP2:
ldi r16, 0x20
rjmp ESCRIBIR_MOTOR

STEP3:
ldi r16, 0x60
rjmp ESCRIBIR_MOTOR

STEP4:
ldi r16, 0x40
rjmp ESCRIBIR_MOTOR

STEP5:
ldi r16, 0xC0
rjmp ESCRIBIR_MOTOR

STEP6:
ldi r16, 0x80
rjmp ESCRIBIR_MOTOR

STEP7:
ldi r16, 0x90

ESCRIBIR_MOTOR:
in r18, PORTD
andi r18, 0b00001111
or r18, r16
out PORTD, r18
ret

MOTOR_OFF:
in r16, PORTD
andi r16, 0b00001111
out PORTD, r16
ret

RETARDO_MOTOR:
ldi r18, 100
RM1:
ldi r19, 100
RM2:
dec r19
brne RM2
dec r18
brne RM1
ret

;USART
;---------------

USART_TX:
TX_WAIT:
lds r18, UCSR0A
sbrs r18, UDRE0
rjmp TX_WAIT
sts UDR0, r16
ret

LINEA_NUEVA:
ldi r16, 13
rcall USART_TX
ldi r16, 10
rcall USART_TX
ret

MSG_CERRADA:
ldi ZL, LOW(TXT_CERRADA*2)
ldi ZH, HIGH(TXT_CERRADA*2)
rjmp ENVIAR_TEXTO

MSG_ABRIENDO:
ldi ZL, LOW(TXT_ABRIENDO*2)
ldi ZH, HIGH(TXT_ABRIENDO*2)
rjmp ENVIAR_TEXTO

MSG_ABIERTA:
ldi ZL, LOW(TXT_ABIERTA*2)
ldi ZH, HIGH(TXT_ABIERTA*2)
rjmp ENVIAR_TEXTO

MSG_CERRANDO:
ldi ZL, LOW(TXT_CERRANDO*2)
ldi ZH, HIGH(TXT_CERRANDO*2)
rjmp ENVIAR_TEXTO

MSG_OBSTACULO:
ldi ZL, LOW(TXT_OBSTACULO*2)
ldi ZH; HIGH(TXT_OBSTACULO*2)
rjmp ENVIAR_TEXTO

MSG_SEGURIDAD:
ldi ZL, LOW(TXT_SEGURIDAD*2)
ldi ZH, HIGH(TXT_SEGURIDAD*2)
rjmp ENVIAR_TEXTO

ET_LOOP:
lmp r16, Z+
tst r16
breq ET_FIN
rcall USART_TX
rjmp ET_LOOP

ET_FIN:
rcall NUEVA_LINEA
ret

TXT_CERRADA:
.db "PUERTA CERRADA", 0

TXT_ABRIENDO:
.db "PUERTA ABRIENDO", 0

TXT_ABIERTA:
.db "PUERTA ABIERTA", 0

TXT_CERRANDO:
.db "PUERTA CERRANDO", 0

TXT_OBSTACULO:
.db "OBSTACULO DETECTADO"

TXT_SEGURIDAD:
.db "MOVIMIENTO DETENIDO POR SEGURIDAD", 0





