.include "m328pdef.inc"

.cseg
.org 0x0000
rjmp RESET

RESET:
;Pila
ldi r16, HIGH(RAMEND)
out SPH, r16
ldi r16, LOW(RAMEND)
out SPL, r16

;PB0, PB1, PB2 = entradas
;D8, D9, D10
cbi DDRB, PB0
cbi DDRB, PB1
cbi DDRB, PB2

;Pull-up internos
sbi PORTB, PB0
sbi PORTB, PB1
sbi PORTB. PB2




MAIN:
rjmp MAIN


