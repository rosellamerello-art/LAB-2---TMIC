; ---------------------------------------------------------
; Espera un comando
; ---------------------------------------------------------
wait:
    rcall getc

    cpi r16, '1'
    breq exec_triangulo

    cpi r16, '2'
    breq exec_circulo

    cpi r16, '3'
    breq exec_pentagrama

    cpi r16, '4'
    breq exec_corazon

    cpi r16, 'P'
    breq exec_bellsprout
    cpi r16, 'p'
    breq exec_bellsprout

    cpi r16, 'T'
    breq exec_todas
    cpi r16, 't'
    breq exec_todas

    rjmp wait

; ---------------------------------------------------------
; Ejecutan cada figura desde el centro
; ---------------------------------------------------------
exec_triangulo:
    rcall centrar
    rcall triangulo
    rcall descentrar
    rjmp msgInicial

exec_circulo:
    rcall centrar
    rcall circulo
    rcall descentrar
    rjmp msgInicial

exec_pentagrama:
    rcall centrar
    rcall pentagrama
    rcall descentrar
    rjmp msgInicial

exec_corazon:
    rcall centrar
    rcall figuraLibre
    rcall descentrar
    rjmp msgInicial

exec_bellsprout:
    rcall centrar
    rcall bellsprout
    rcall descentrar
    rjmp msgInicial

exec_todas:
    sbi PORTD, 4
	sbi PORTD, 7
	rcall s1Delay
	rcall sCircDelay
	cbi PORTD, 7
	rcall s1Delay
	cbi PORTD, 4
	rcall triangulo
	sbi PORTD, 7
	sbi PORTD, 4
	ldi r17, 17
todasloop1:	
	rcall sCircDelay
	dec r17
	brne todasloop1
	cbi PORTD, 4
	ldi r17, 17
todasloop2:
	rcall sCircDelay
	dec r17
	brne todasloop2
	cbi PORTD, 7
	rcall circulo
	sbi PORTD, 7
	ldi r17, 20
todasloop3:
	rcall sCircDelay
	dec r17
	brne todasloop3
	cbi PORTD, 7
	rcall pentagrama
	sbi PORTD, 4
	ldi r17, 50
todasloop4:
	rcall sCircDelay
	dec r17
	brne todasloop4
	cbi PORTD, 4
	rcall figuraLibre
	sbi PORTD, 6
	ldi r17, 40
todasloop5:
	rcall sCircDelay
	dec r17
	brne todasloop5
	cbi PORTD, 6
	rcall bellsprout
	rjmp msgInicial

; ---------------------------------------------------------
; Control de la pluma
; ---------------------------------------------------------
bajar_lapiz:
    sbi PORTD, 2            ; Pulso para bajar la pluma
    rcall s1Delay
    cbi PORTD, 2
    ret

subir_lapiz:
    sbi PORTD, 3            ; Pulso para subir la pluma
    rcall s1Delay
    cbi PORTD, 3
    ret

; ---------------------------------------------------------
; Figuras
; ---------------------------------------------------------

; --- Triángulo ---
triangulo:
    rcall bajar_lapiz

    sbi PORTD, 5            ; Arriba
    rcall s1Delay
    rcall s1Delay
    cbi PORTD, 5

    sbi PORTD, 4            ; Abajo + Izquierda
    sbi PORTD, 6
    rcall s1Delay
    cbi PORTD, 6

    sbi PORTD, 7            ; Derecha y abajo
    rcall s1Delay
    cbi PORTD, 7
    cbi PORTD, 4

    rcall subir_lapiz
    ret

; --- Círculo ---
; La trayectoria se guarda en una LUT para no calcular seno/coseno.
;
; Se usan los signos de dx y dy para elegir el movimiento de los motores.

; Se eliminaron los puntos que no generaban ningún movimiento.

; Cada paso espera aproximadamente 80 ms.
circulo:
    rcall bajar_lapiz

    ldi  ZL, low(circulo_lut<<1)
    ldi  ZH, high(circulo_lut<<1)
    ldi  r23, CIRC_PASOS         ; cantidad de pasos en la tabla
circulo_loop:
    lpm  r16, Z+
    out  PORTD, r16
    rcall sCircDelay
    dec  r23
    brne circulo_loop

    ldi  r16, 0
    out  PORTD, r16
    rcall subir_lapiz
    ret

; --- Pentagrama ---
pentagrama:
    rcall bajar_lapiz
    ldi  ZL, low(pentagrama_lut<<1)
    ldi  ZH, high(pentagrama_lut<<1)
    ldi  r23, PENTAGRAMA_PASOS
pentagrama_loop:
    lpm  r16, Z+
    out  PORTD, r16
    rcall sCircDelay
    dec  r23
    brne pentagrama_loop
    ldi  r16, 0
    out  PORTD, r16
    rcall subir_lapiz
    ret

; --- Figura libre: corazón ---
; La trayectoria del corazón está guardada en una LUT.
; Cada valor indica hacia dónde mover los motores.
figuraLibre:
    rcall bajar_lapiz

    ldi  ZL, low(corazon_lut<<1)
    ldi  ZH, high(corazon_lut<<1)
    ldi  r23, CORAZON_PASOS
corazon_loop:
    lpm  r16, Z+
    out  PORTD, r16
    rcall sCircDelay
    dec  r23
    brne corazon_loop

    ldi  r16, 0
    out  PORTD, r16
    rcall subir_lapiz
    ret

; --- Bellsprout ---
bellsprout:
    rcall bajar_lapiz
    ldi   ZL, low(bellsprout_lut<<1)
    ldi   ZH, high(bellsprout_lut<<1)

    ldi   r24, low(BELLSPROUT_PASOS)
    ldi   r25, high(BELLSPROUT_PASOS)
    ldi   r22, 1                ; 1 = lapiz abajo (ya lo bajamos arriba)

bellsprout_loop:
    lpm   r16, Z+
    cpi   r16, 0x08              ; ¿marcador "subir lapiz"?
    breq  bellsprout_subir
    cpi   r16, 0x04              ; ¿marcador "bajar lapiz"?
    breq  bellsprout_bajar

    out   PORTD, r16
    rcall sCircDelay
    rjmp  bellsprout_dec

bellsprout_subir:
    rcall subir_lapiz            ; Pulso para subir la pluma
    rjmp  bellsprout_dec
bellsprout_bajar:
    rcall bajar_lapiz            ; Pulso para bajar la pluma
    ; cae a bellsprout_dec

bellsprout_dec:
    sbiw  r24, 1
    brne  bellsprout_loop

    ldi   r16, 0
    out   PORTD, r16
    rcall subir_lapiz
    ret

; ---------------------------------------------------------
; Posicionamiento
; ---------------------------------------------------------
centrar:
    sbi PORTD, 7            ; Derecha y abajo
    sbi PORTD, 4
    ldi r21, 5
cenloop1:
    rcall s1Delay
    dec r21
    cpi r21, 0
    brne cenloop1

    cbi PORTD, 4
    ldi r21, 5
cenloop2:
    rcall s1Delay
    dec r21
    cpi r21, 0
    brne cenloop2

    cbi PORTD, 7
    ret

descentrar:
    sbi PORTD, 6            ; Izquierda y arriba
    sbi PORTD, 5
    ldi r21, 5
dcenloop1:
    rcall s1Delay
    dec r21
    cpi r21, 0
    brne dcenloop1

    cbi PORTD, 5
    ldi r21, 5
dcenloop2:
    rcall s1Delay
    dec r21
    cpi r21, 0
    brne dcenloop2

    cbi PORTD, 6
    ret

; ---------------------------------------------------------
; Delay de aproximadamente 1 segundo
; ---------------------------------------------------------
s1Delay:
    ldi r18, 199
L1: ldi r19, 199
L2: ldi r20, 134
L3: dec r20
    brne L3
    dec r19
    brne L2
    dec r18
    brne L1
    ret

; ---------------------------------------------------------
; Delay corto para el trazado
; Aproximadamente 80 ms
; ---------------------------------------------------------
sCircDelay:
    ldi r18, 16
SL1: ldi r19, 199
SL2: ldi r20, 134
SL3: dec r20
    brne SL3
    dec r19
    brne SL2
    dec r18
    brne SL1
    ret

