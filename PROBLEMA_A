;IMPLEMENTA MULTIPLEXADO DE MATRÍZ 8X8

MOSTRAR_COLUMNAS:
ldi r25, 0

SIGUIENTE_COLUMNA:
ldi ZH, HIGH(MENSAJE*2)
ldi ZL, LOW(MENSAJE*2)

add ZL, r23
clr r16
adc ZH, r16

lpm r20, Z
rcall MOSTRAR_COLUMNA

inc r25
cpi r25, 8
brne SIGUIENTE_COLUMNA
ret

MOSTRAR_COLUMNA:
rcall APAGAR_TODO

cpi r25, 0
breq COL1

cpi r25, 1
breq COL2

cpi r25, 2
breq COL3

cpi r25, 3
breq COL4

cpi r25, 4
breq COL5

cpi r25, 5
breq COL6

cpi r25, 6
breq COL7

rjmp COL8

COL1:
sbi PORTB, 0
rjmp MOSTRAR_FILAS

COL2:
sbi PORTB, 1
rjmp MOSTRAR_FILAS

COL3:
sbi PORTB, 2
rjmp MOSTRAR_FILAS

COL4:
sbi PORTB, 3
rjmp MOSTRAR_FILAS

COL5:
sbi PORTB, 4
rjmp MOSTRAR_FILAS

COL6:
sbi PORTB, 5
rjmp MOSTRAR_FILAS

COL7:
sbi PORTC, 0
rjmp MOSTRAR_FILAS

COL8:
sbi PORTC, 1

MOSTRAR_FILAS:

sbrs r20, 0
rjmp NO_F1
cbi PORTD, 2

NO_F1:
sbrs r20, 1
rjmp NO_F2
cbi PORTD, 3

NO_F2:
sbrs r20, 2
rjmp NO_F3
cbi PORTD, 4

NO_F3:
sbrs r20, 3
rjmp NO_F4
cbi PORTD, 5

NO_F4:
sbrs r20, 4
rjmp NO_F5
cbi PORTD, 6

NO_F5:
sbrs r20, 5
cbi PORTD, 7

NO_F6:
sbrs r20, 6
rjmp NO_F7
cbi PORTC, 2

NO_F7:
sbrs r20, 7
rjmp NO_F8
cbi PORTC, 3

NO_F8:
rcall RETARDO_MUX
ret

;AGREGA CARITA SONRIENTE Y CARITA GUINO

MOSTRAR_CARITA:
rcall APAGAR_TODO
sbi PORTB, 2
sbi PORTB, 5
cbi PORTD, 3
rcall RETARDO_MUX

rcall APAGAR_TODO
sbi PORTB, 2
sbi PORTB, 3
sbi PORTB, 4
sbi PORTB, 5
cbi PORTD, 7
rcall RETARDO_MUX

ret

MOSTRAR_GUINO:
rcall APAGAR_TODO
sbi PORTB, 2
sbi PORTB, 5
sbi PORTc, 0
cbi PORTd, 3
rcall RETARDO_MUX

rcall APAGAR_TODO
sbi PORTC, 0
cbi PORTD, 4
rcall RETARDO_MUX

rcall APAGAR_TODO
sbi PORTB, 1
sbi PORTC, 0
cbi PORTD, 6
rcall RETARDO_MUX

rcall APAGAR_TODO
sbi PORTB, 2
sbi PORTB, 3
sbi PORTB, 4
sbi PORTB, 5
cbi PORTD, 7
rcall RETARDO_MUX

ret

APAGAR_TODO:
ldi r16, 0
out PORTB, r16

cbi PORTC, 0
cbi PORTC, 1

ldi r16, 0b11111100
out PORTD, r16
sbi PORTC, 2
sbi PORTC, 3

ret

RETARDO_MUX:

ldi r18, 60

MUX_LOOP:

dec r18
brne MUX_LOOP

ret

;IMPLEMENTA DESPLAZAMIENTO Y VELOCIDAD VARIABLE

MOSTRAR_VENTANA:
cpi r19, 1
breq RETARDO_SCROLL_LENTO

cpi r19, 2
breq RETARDO_SCROLL_MEDIO
rjmp RETARDO_SCROLL_RAPIDO

RETARDO_SCROLL_LENTO:
ldi r24, 2
LENTO_EXTERNO:
ldi r21, 190
LENTO_INTERNO:
rcall MOSTRAR_COLUMNAS
dec r21
brne LENTO_INTERNO
dec r24
brne LENTO_EXTERNO

ret

RETARDO_SCROLL_MEDIO:
ldi r24, 2
MEDIO_EXTERNO:
ldi r21, 100
MEDIO_INTERNO:
rcall MOSTRAR_COLUMNAS
dec r21
brne MEDIO_INTERNO
dec r24
brne MEDIO_EXTERNO

ret

RETARDO_SCROLL_RAPIDO:
ldi r24, 1
RAPIDO_EXTERNO:
ldi r21, 100
RAPIDO_INTERNO:
rcall MOSTRAR_COLUMNAS
dec r21
brne RAPIDO_INTERNO
dec r24
brne RAPIDO_EXTERNO

ret

