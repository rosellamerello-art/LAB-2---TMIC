    ldi r16, '-'
    rcall putc
    ldi r16, 'P'
    rcall putc
    ldi r16, 'e'
    rcall putc
    ldi r16, 'n'
    rcall putc
    ldi r16, 't'
    rcall putc
    ldi r16, 'a'
    rcall putc
    ldi r16, 'g'
    rcall putc
    ldi r16, 'r'
    rcall putc
