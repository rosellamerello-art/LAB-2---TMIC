.org    0x0000
    rjmp inicializacion

.equ F_CPU = 16000000
.equ baud  = 9600
.equ bps   = (F_CPU/16/baud) - 1

; ---------------------------------------------------------
; Inicialización
; ---------------------------------------------------------
inicializacion:
    ldi r16, high(RAMEND)
    out SPH, r16
    ldi r16, low(RAMEND)
    out SPL, r16

    ldi r16, low(bps)
    ldi r17, high(bps)
    rcall initUART

    ldi r16, 0xFE
    out DDRD, r16        ; Salidas en PORTD, excepto PD0 (RX)

    rjmp msgInicial

; ---------------------------------------------------------
; UART
; ---------------------------------------------------------
initUART:
    sts UBRR0L, r16
    sts UBRR0H, r17
    ldi r16, (1<<RXEN0)|(1<<TXEN0)
    sts UCSR0B, r16
    ret

putc:
    lds r17, UCSR0A
    sbrs r17, UDRE0
    rjmp putc
    sts UDR0, r16
    ret

getc:
    lds r17, UCSR0A
    sbrs r17, RXC0
    rjmp getc
    lds r16, UDR0
    ret

; ---------------------------------------------------------
; Menú por UART
; ---------------------------------------------------------
msgInicial:
    ; Opción 1: triángulo
    ldi r16, '1'
    rcall putc
    ldi r16, '-'
    rcall putc
    ldi r16, 'T'
    rcall putc
