.include "m328pdef.inc"

.cseg
.org 0x0000
rjmp RESET

RESET:
ldi r16, HIGH (RAMEND)
out SPH, r16
ldi r16, LOW (RAMEND)
out SPL, r16

; DAC: PD2-PD7 salidas
ldi r16, 0b11111100
out DDRD, r16

; DAC: PB0-PB1 salidas
ldi r16, 0b00000011
out DDRB, r16

;Salidas inicialmente en cero
ldi r16, 0
out PORTD, r16
out PORTB, r16

;USUART 9600 baud
ldi r16, 0
sts UBRR0H, r16
ldi r16, 103
sts UBRR0L, r16
ldi r16, (1<<RXEN0) | (1<<TXEN0)
sts UCSR0B, r16
ldi r16, (1<<UCSZ01) | (1<<UCSZ00)
sts UCSR0C, R16

;Timer1 CTC,OCR1A=124,prescaler 1
ldi r16, 0
sts TCCR1A, r16
sts TCNT1H, r16
sts TCNT1L, r16
sts OCR1AH, r16
ldi r16, 124
sts OCR1AL, r16
ldi r16, (1<<OCF1A)
out TIFR1, r16
ldi r16,(1<<WGM12) | (1<<CS10)
sts TCCR1B, r16

;r22=señal seleccionada: 12 por defecto

ldi r22, 12
;r24= índice 0...255

clr r24
rcall MENU


MAIN:
;Revisar USART sin bloquear
lds r18, UCSR0A
sbrs r18, RXC0
rjmp ESPERAR_TIMER
lds r17, UDR0
cpi r17,'1'
breq SEL_12
cpi r17, '2'
breq SEL_13
rjmp ESPERAR_TIMER

SEL_12:
ldi r22, 12
clr r24
rjmp ESPERAR_TIMER

SEL_13:
ldi r22, 13
clr r24

ESPERAR_TIMER:
;Esperar compare match
in r18, TIFR1
sbrs r18, OCF1A
rjmp MAIN
;Limpiar flag escribiendo 1
ldi r18, (1<<OCF1A)
out TIFR1, r18
;Elegir LUT
cpi r22, 13
breq LEER_13

LEER_13:
ldi ZL, LOW(SENAL13*2)
ldi ZH, HIGH(SENAL13*2)

	rjmp MAIN
	MENU: 
	ret


