    rcall putc
    ldi r16, 'm'
    rcall putc
    ldi r16, 'a'
    rcall putc
    ldi r16, 0x0A
    rcall putc

    ; Opción 4: figura libre
    ldi r16, '4'
    rcall putc
    ldi r16, '-'
    rcall putc
    ldi r16, 'F'
