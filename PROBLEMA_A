;CONFIGURA PUERTOS E INICIALIZACION DEL ATMEGA328P"
.inlude "m328pdef.inc"
.cseg
.org 0x0000
rjmp RESET

RESET:
ldi r16, HIGH (RAMEND)
out SPH, r16

ldi r16, LOW (RAMEND)
out SPL, r16

ldi r16, 0b11111100
out DDRD, r16

ldi r16, 0b00111111
out DDRB, r16

ldi r16, 0b00001111
out DDRC, r16

rcall APAGAR_TODO
ldi r16, 0
sts UBRR0H, r16

ldi r16, 103
sts UBRR0L, r16

ldi r16, (1<< RXEN0)|(1<<TXEN0)
sts UCSR0B

ldi r16, (1<<UCSZ01)|(1<<UCSZ00)
sts UCSR0C, r16

ldi r22, 0
ldi r23, 0
ldi r19, 1
rcall MENU

;AGREGA USART Y MENU DE SELECCION

MAIN:
lds r18, UCSR0A
sbrs r18, RXC0
rjmp EJECUTAR_MODO

lds r17, UDR0
cpi r17, '1'
breq ACTIVAR_MENSAJE
cpi r17, '2'
breq ACTIVAR_CARITA
cpi r17, '3'
breq ACTIVAR_GUINO
cpi r17, '4'
breq VELOCIDAD_LENTA
cpi r17, '5'
breq VELOCIDAD_MEDIA
cpi r17, '6'
breq VELOCIDAD_RAPIDA

rjmp EJECUTAR_MODO

ACTIVAR_MENSAJE:
ldi r22, 1
ldi r23, 0
rcall APAGAR_TODO
rjmp EJECUTAR_MODO

ACTIVAR_CARITA:
ldi r22, 2
rcall APAGAR_TODO
rjmp EJECUTAR_MODO

ACTIVAR_GUINO:
ldi r22, 3
rcall APAGAR_TODO
rjmp EJECUTAR_MODO

VELOCIDAD_LENTA:
ldi r19, 1
rjmp EJECUTAR_MODO

VELOCIDAD_MEDIA:
ldi r19, 2
rjmp EJECUTAR_MODO

VELOCIDAD_RAPIDA:
ldi r19, 3
rjmp EJECUTAR_MODO

EJECUTAR_MODO:
cpi r22, 1
breq MODO_MENSAJE

cpi r22, 2
breq MODO_CARITA

cpi r22, 3
breq MODO_GUINO

rjmp MAIN

MODO_MENSAJE:
rcall MOSTRAR_VENTANA
inc r23
cpi r23, 95
brlo CONTINUAR_SCROLL
ldi r23, 0

CONTINUAR_SCROLL:
rjmp MAIN

MODO_CARITA:
rcall MOSTRAR_CARITA
rjmp MAIN

MODO_GUINO:
rcall MOSTRAR_GUINO
rjmp MAIN

USART_TX:
ESPERAR_TX:
lds r18, UCSR0A
sbrs r18, UDRE0
rjmp ESPERAR_TX
sts UDR0, r16
ret

