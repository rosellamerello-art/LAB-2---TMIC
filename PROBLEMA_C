.org    0x0000
    rjmp inicializacion

.equ F_CPU = 16000000
.equ baud  = 9600
.equ bps   = (F_CPU/16/baud) - 1


; =========================================================
; INICIALIZACION
; =========================================================

inicializacion:

    ; -------------------------
    ; Configurar Stack Pointer
    ; -------------------------

    ldi r16, high(RAMEND)
    out SPH, r16

    ldi r16, low(RAMEND)
    out SPL, r16


    ; -------------------------
    ; Configurar UART
    ; -------------------------

    rcall initUART


    ; -------------------------
    ; Configurar PORTD
    ; -------------------------

    ldi r16, 0xFE
    out DDRD, r16


    ; -------------------------
    ; Mensaje inicial
    ; -------------------------

    ldi ZH, high(msgInicio << 1)
    ldi ZL, low(msgInicio << 1)

    rcall putstr


loop:
    rjmp loop


; =========================================================
; UART
; =========================================================

initUART:

    ; Baud rate = 9600
    ldi r16, high(bps)
    sts UBRR0H, r16

    ldi r16, low(bps)
    sts UBRR0L, r16

    ; Habilitar RX y TX
    ldi r16, (1 << RXEN0) | (1 << TXEN0)
    sts UCSR0B, r16

    ; 8 bits, 1 stop bit, sin paridad
    ldi r16, (1 << UCSZ01) | (1 << UCSZ00)
    sts UCSR0C, r16

    ret


; =========================================================
; TRANSMITIR UN CARACTER
; =========================================================

putc:

    lds r17, UCSR0A

    sbrs r17, UDRE0
    rjmp putc

    sts UDR0, r16

    ret


; =========================================================
; TRANSMITIR CADENA
; Z -> direccion de la cadena
; =========================================================

putstr:

    lpm r16, Z+

    cpi r16, 0
    breq putstr_fin

    rcall putc

    rjmp putstr

putstr_fin:
    ret


; =========================================================
; MENSAJE INICIAL
; =========================================================

msgInicio:
    .db "Sistema iniciado", 13, 10, 0
