.include "m328pdef.inc"

.cseg
.org 0x0000
rjmp RESET

RESET:
;Pila
ldi r16, HIGH(RAMEND)
out SPH, r16
ldi r16, LOW(RAMEND)
out SPL, r16

;PB0, PB1, PB2 = entradas
;D8, D9, D10
cbi DDRB, PB0
cbi DDRB, PB1
cbi DDRB, PB2

;Pull-up internos
sbi PORTB, PB0
sbi PORTB, PB1
sbi PORTB, PB2

;USART 9600 baud - 8N1
ldi r16, 0
sts UBRR0H, r16
ldi r16, 103
sts UBRR0L, r16

;Solo transmisor
ldi r16, (1<<TXEN0)
sts UCSR0B, r16
ldi r16, (1<<UCSZ01) | (1<<UCSZ00)
sts UCSR0C, r16


MAIN:
;Leer PB0-PB2
in r16, PINB
andi r16, 0b00000111

; Pulsadores activos LOW: pulsado = 1
com r16
andi r16, 0b00000111

;r16 contiene 0...7
rcall USART_TX
rlmp MAIN

USART_TX:
ESPERAR_TX:
lds r17, UCSR0A
sbrs r17, UDRE0
rjmp ESPERAR_TX
sts UDR0, r16
ret

rcall RETARDO
RETARDO:
ldi r18, 40
RET1:
ldi r19, 255
RET2:
ldi r20, 255
RET3:
dec r20
brne RET3
dec r19
brne RET2
dec r18
brne RET1
ret


rjmp MAIN


